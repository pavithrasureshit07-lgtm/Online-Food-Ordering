digraph Architecture {
  graph [rankdir=LR, bgcolor="white", pad="0.35", nodesep="0.45", ranksep="0.65", splines=ortho, fontname="Arial", label="LAYERED SYSTEM ARCHITECTURE – ONLINE FOOD ORDERING & SALES ANALYSIS", labelloc=t, fontsize=19];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=10, color="#64748b", penwidth=1.2, margin="0.16,0.10"];
  edge [color="#475569", penwidth=1.3, arrowsize=.75, fontname="Arial", fontsize=9];
  subgraph cluster_users { label="USERS"; style="rounded,filled"; color="#cbd5e1"; fillcolor="#f8fafc"; Staff [label="Restaurant Staff\n(Menu & Order Operations)", fillcolor="#e2e8f0"]; Manager [label="Restaurant Manager\n(Sales Review)", fillcolor="#e2e8f0"]; }
  subgraph cluster_app { label="APPLICATION / PRESENTATION LAYER"; style="rounded,filled"; color="#67c5b7"; fillcolor="#e6fffb"; Console [label="Java Console Interface\nMenu-driven interaction", fillcolor="#99f6e4"]; }
  subgraph cluster_logic { label="BUSINESS LOGIC & DATA ACCESS"; style="rounded,filled"; color="#f0b44c"; fillcolor="#fffbeb"; Operations [label="Business Operations\nCustomers • Menu • Orders\nStatus • Daily Sales", fillcolor="#fde68a"]; JDBC [label="JDBC Data Access\nPrepared Statements\nOrder Transaction", fillcolor="#fed7aa"]; }
  subgraph cluster_data { label="BACK-END DATA RESOURCES"; style="rounded,filled"; color="#9b8de0"; fillcolor="#f5f3ff"; MySQL [label="MySQL Server\ncustomers\nmenu_items\norders\norder_items", fillcolor="#ddd6fe"]; }
  subgraph cluster_analytics { label="FDS / ANALYTICS LAYER"; style="rounded,filled"; color="#60a5fa"; fillcolor="#eff6ff"; Python [label="Python Data Retrieval\n& Preprocessing", fillcolor="#bfdbfe"]; CSV [label="Processed Order Dataset\nCSV", fillcolor="#dbeafe"]; Charts [label="Sales & Popular-Item\nVisualizations", fillcolor="#bfdbfe"]; }
  Staff -> Console [label="manage / enter data"];
  Manager -> Console [label="request reports"];
  Console -> Operations [label="user actions"];
  Operations -> JDBC [label="validated operations"];
  JDBC -> MySQL [label="SQL via JDBC"];
  MySQL -> Python [label="retrieve stored records"];
  Python -> CSV [label="clean / transform"];
  CSV -> Charts [label="analyze"];
}
